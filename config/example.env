# Source images
PIWIGO_BASE_DIR=/path/to/piwigo
PIWIGO_GALLERY_DIR=/path/to/piwigo/upload
PIWIGO_RANDOM_PHP=/path/to/piwigo/random.php

# Build settings
SLIDE_COUNT=15
MAX_EDGE_PX=2048
JPEG_QUALITY=85

# Output directories
OUTPUT_STAGING_DIR=output/staging
OUTPUT_PUBLISH_DIR=public
LOG_DIR=logs
STATE_DIR=state

# Optional metadata
PUBLIC_BASE_URL=
CUSTOM_DOMAIN=

# Deploy settings
GITHUB_REPO_URL=https://github.com/<owner>/<repo>
GITHUB_BRANCH=main
GITHUB_TOKEN=
